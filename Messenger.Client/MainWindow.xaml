<Window x:Class="Messenger.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Messenger.Client.ViewModels"
        xmlns:dto="clr-namespace:Messenger.Shared.Dtos;assembly=Messenger.Shared"
        xmlns:loc="clr-namespace:Messenger.Client.Localization"
        Title="Messenger" Height="700" Width="1000" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#fdf3f5"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ── Chat list item style ── -->
        <Style x:Key="ChatListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#fbe9ec"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f7d3da"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Chat item data template ── -->
        <DataTemplate x:Key="ChatItemTemplate" DataType="{x:Type vm:ChatItemViewModel}">
            <Grid Height="64" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Fill="{Binding OtherUserName, Converter={StaticResource AvatarColorConverter}}"/>
                    <TextBlock Text="{Binding OtherUserName, Converter={StaticResource FirstLetterConverter}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Ellipse Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#22c55e" Stroke="White" StrokeThickness="2"
                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                    <TextBlock Text="{Binding OtherUserName}" Foreground="#1a2332"
                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding LastMessageText}" Foreground="#6b7a8d"
                               FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}"
                           Foreground="#6b7a8d" FontSize="11"
                           VerticalAlignment="Top" Margin="0,14,12,0"/>
            </Grid>
        </DataTemplate>

        <!-- ── Message data template ── -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageViewModel}">
            <Grid Margin="8,2">
                <Border Padding="10,7" MaxWidth="460">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#ffffff"/>
                            <Setter Property="BorderBrush" Value="#f0dbe1"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="CornerRadius" Value="12,12,12,4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                    <Setter Property="Background" Value="#e06c7d"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="CornerRadius" Value="12,12,4,12"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding SenderUsername}" Foreground="#e06c7d"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1a2332"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TimeDisplay}" FontSize="11"
                                   HorizontalAlignment="Right" Margin="24,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#9daab8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                            <Setter Property="Foreground" Value="#f6d6dc"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ── User list item (new-chat panel) ── -->
        <DataTemplate x:Key="UserItemTemplate" DataType="{x:Type dto:UserDto}">
            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Command="{Binding DataContext.OpenChatWithUserCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Height="56">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Ellipse Fill="{Binding Username, Converter={StaticResource AvatarColorConverter}}"/>
                                    <TextBlock Text="{Binding Username, Converter={StaticResource FirstLetterConverter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Username}" Foreground="#1a2332"
                                           FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#fbe9ec"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- ── Send button style ── -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Background" Value="#e06c7d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#cf5567"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Icon button style ── -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6b7a8d"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f9dde2"/>
                                <Setter Property="Foreground" Value="#e06c7d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Language button style ── -->
        <Style x:Key="LangButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9daab8"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="380"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════ LEFT SIDEBAR ════════ -->
        <Grid Grid.Column="0" Background="#ffffff">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar header -->
            <Grid Grid.Row="0" Background="#fdf6f8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Grid Width="32" Height="32">
                        <Ellipse Fill="{Binding CurrentUsername, Converter={StaticResource AvatarColorConverter}}"/>
                        <TextBlock Text="{Binding CurrentUsername, Converter={StaticResource FirstLetterConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="Bold" Foreground="White"/>
                    </Grid>
                    <TextBlock Text="{Binding CurrentUsername}" Foreground="#1a2332" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <!-- Language switcher -->
                    <Button Content="UA"
                            Command="{Binding SetLanguageCommand, Source={x:Static loc:LocalizationService.Instance}}"
                            CommandParameter="UA">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Language, Source={x:Static loc:LocalizationService.Instance}}"
                                                 Value="{x:Static loc:AppLanguage.Ukrainian}">
                                        <Setter Property="Foreground" Value="#e06c7d"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="|" Foreground="#f0dbe1" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="EN"
                            Command="{Binding SetLanguageCommand, Source={x:Static loc:LocalizationService.Instance}}"
                            CommandParameter="EN">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LangButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Language, Source={x:Static loc:LocalizationService.Instance}}"
                                                 Value="{x:Static loc:AppLanguage.English}">
                                        <Setter Property="Foreground" Value="#e06c7d"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Action buttons -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE721;"
                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                            ToolTip="{Binding SearchTooltip, Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding ToggleUsersPanelCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="←"
                            ToolTip="{Binding LogoutTooltip, Source={x:Static loc:LocalizationService.Instance}}"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Chat list -->
            <ListBox Grid.Row="1" x:Name="ChatsListBox"
                     ItemsSource="{Binding Chats}"
                     SelectedItem="{Binding SelectedChat, Mode=TwoWay}"
                     ItemTemplate="{StaticResource ChatItemTemplate}"
                     ItemContainerStyle="{StaticResource ChatListItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding IsUsersPanelOpen, Converter={StaticResource InvertBoolToVisibilityConverter}}"/>

            <!-- Users panel (overlay) -->
            <Grid Grid.Row="1" Background="#ffffff"
                  Visibility="{Binding IsUsersPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#fdf6f8" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="←" Margin="0,0,8,0"
                                Command="{Binding ToggleUsersPanelCommand}"/>
                        <TextBlock Text="{Binding NewChatTitle, Source={x:Static loc:LocalizationService.Instance}}"
                                   Foreground="#1a2332" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Search box -->
                <Border Grid.Row="1" Background="#ffffff" Padding="10,8">
                    <Border Background="#fbeef1" CornerRadius="18" Height="34">
                        <Grid>
                            <TextBlock Text="{Binding SearchPlaceholder, Source={x:Static loc:LocalizationService.Instance}}"
                                       Foreground="#9daab8" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding UserSearchQuery,
                                           Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <TextBox Background="Transparent" Foreground="#1a2332" BorderThickness="0"
                                     CaretBrush="#1a2332" FontSize="13" VerticalAlignment="Center"
                                     Margin="12,0"
                                     Text="{Binding UserSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Empty state -->
                <TextBlock Grid.Row="2"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#9daab8" Margin="20,0"
                           Visibility="{Binding HasUserResults, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding SearchHint, Source={x:Static loc:LocalizationService.Instance}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UserSearchQuery,
                                    Converter={StaticResource StringEmptyToVisibilityConverter}}"
                                    Value="Collapsed">
                                    <Setter Property="Text" Value="{Binding NoUsersFound, Source={x:Static loc:LocalizationService.Instance}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox Grid.Row="2" ItemsSource="{Binding Users}"
                         Visibility="{Binding HasUserResults, Converter={StaticResource BoolToVisibilityConverter}}"
                         ItemTemplate="{StaticResource UserItemTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Column="1" Width="1" Fill="#f0dbe1"/>

        <!-- ════════ RIGHT PANEL ════════ -->
        <Grid Grid.Column="2" Background="#fdf3f5">

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasSelectedChat, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                <TextBlock Text="💬" FontSize="56" HorizontalAlignment="Center" Opacity="0.25"/>
                <TextBlock Text="{Binding SelectChatHint, Source={x:Static loc:LocalizationService.Instance}}"
                           Foreground="#6b7a8d" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- Chat view -->
            <Grid Visibility="{Binding HasSelectedChat, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat header -->
                <Border Grid.Row="0" Background="#ffffff"
                        BorderBrush="#f0dbe1" BorderThickness="0,0,0,1">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                            <Ellipse Fill="{Binding SelectedChat.OtherUserName,
                                           Converter={StaticResource AvatarColorConverter}}"/>
                            <TextBlock Text="{Binding SelectedChat.OtherUserName,
                                             Converter={StaticResource FirstLetterConverter}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="16" FontWeight="Bold" Foreground="White"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="{Binding SelectedChat.OtherUserName}"
                                       Foreground="#1a2332" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedChat.OnlineStatusText}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9daab8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChat.IsOnline}" Value="True">
                                                <Setter Property="Foreground" Value="#22c55e"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Messages -->
                <ScrollViewer Grid.Row="1" x:Name="MessagesScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#fdf3f5" Padding="0,6">
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  ItemTemplate="{StaticResource MessageTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Input area -->
                <Border Grid.Row="2" Background="#ffffff"
                        BorderBrush="#f0dbe1" BorderThickness="0,1,0,0">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#fbeef1" CornerRadius="20" Padding="14,0">
                            <TextBox x:Name="MessageInput"
                                     Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#1a2332" CaretBrush="#1a2332"
                                     BorderThickness="0" FontSize="14"
                                     VerticalAlignment="Center" MinHeight="40" MaxHeight="120"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     VerticalScrollBarVisibility="Auto">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                                </TextBox.InputBindings>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <TextBlock
                                                            Text="{Binding MessagePlaceholder, Source={x:Static loc:LocalizationService.Instance}}"
                                                            Foreground="#9daab8" FontSize="14"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding DataContext.MessageInput,
                                                                RelativeSource={RelativeSource AncestorType=Window},
                                                                Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      VerticalAlignment="Center"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                        <Button Grid.Column="2" Content="↑"
                                Style="{StaticResource SendButton}"
                                Command="{Binding SendMessageCommand}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
